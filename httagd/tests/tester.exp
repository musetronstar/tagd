	400 {_error:url_err_host} 1

# A percent escape in the URL host is rejected after transport decoding.
foreach host {ex%FFample.com ex%C0%AFample.com ex%C2%85ample.com ex%E6%97%A5ample.com
	ex%25FFample.com ex%61mple.com} {
	test_response "escaped_host_body_$host" POST {http://localhost:2112/} \
		400 {_error:url_err_host} 1 \
		">> https://$host/; >> escaped_host_body_write _sub _entity;"
	test_response "escaped_host_get_$host" GET "http://localhost:2112/_/:_url:?_url=https://$host/" \
		400 {_error:tagl_err} 1
	test_response "escaped_host_put_$host" PUT "http://localhost:2112/_/:_url:?_url=https://$host/" \
		400 {_error:tagl_err} 1 {>> escaped_host_put_write _sub _entity;}
}
foreach tag {escaped_host_body_write escaped_host_put_write} {
	test_response "escaped_host_no_mutation_$tag" GET "http://localhost:2112/_/$tag" \
		404 {_error:ts_not_found} 1
}
test_response escaped_host_encoded_url GET \
	{http://localhost:2112/_/https%3A%2F%2Fex%25FFample.com%2F} 400 {_error:url_err_host} 1
test_response escaped_host_hduri GET \
	{http://localhost:2112/_/hd:com!ex%25FFample!!/!!!!!!https} 400 {_error:url_err_host} 1

# HTTP escaping carries the literal Unicode host; it is not a percent-escaped URL host.
test_response unicode_host_declare POST {http://localhost:2112/} 200 {>> err:} 0 \
	{>> https://日.example.com/Transport;}
test_response unicode_host_http_hduri GET \
