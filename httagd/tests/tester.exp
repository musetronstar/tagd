	{>> https://EXAMPLE.com/Case;}
test_response url_host_case_get GET {http://localhost:2112/_/:_url:?_url=https://Example.COM/Case} \
	200 {https://example.com/Case} 1
test_response url_host_case_hduri_rejected GET \
	{http://localhost:2112/_/hd:com!EXAMPLE!!/Case!!!!!!https} 400 {_error:hduri_err} 1
