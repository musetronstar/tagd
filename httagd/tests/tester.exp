#!/usr/bin/expect

# exp_internal 1   ;# diagnostics

set spawn_httagd "spawn ../bin/httagd --log-level emergency,_role:httagd:debug --file ../../tagsh/tests/bootstrap.tagl --www-dir ./www"

set MAX_ERRORS 3
set ERRORS 0
set NL "\r\n"
set TIMEOUT 1
set STARTUP_TIMEOUT 10

set timeout $TIMEOUT
set log_user 1  ;# log output to stdout, 0 disables

proc test_pass {n} {
	puts "\n****** $n passed ******\n"
}

proc test_fail {n} {
	puts "\n^^^^^^ $n failed ^^^^^^\n"
}

# launches curl using args and expects
# n = <test_name>, m = method, u = url, d = <body_data>, e = <expect_args>
proc test {n m u d e} {
	upvar 1 ERRORS errors
	upvar 1 MAX_ERRORS max_errors
	upvar 1 NL nl

	set match 0

	if { [string length $d] == 0 } {
		spawn curl -D - -X$m "http://localhost:2112$u"
	} else {
		spawn curl -D - -X$m "http://localhost:2112$u" --data "$d"
	}

	expect {
		-regexp $e  {
				test_pass $n
				set match 1
			}
	}

	if {$match} { return }

	test_fail $n
	incr errors

	if {$errors >= $max_errors} {
		puts "$errors errors. Exiting..."
		exit $errors
	}
}

# launches curl using args and expects
# n = <test_name>, m = method, u = url, f = filename, e = <expect_args>
proc test_file {n m u f e} {
	upvar 1 ERRORS errors
	upvar 1 MAX_ERRORS max_errors
	upvar 1 NL nl

	set match 0

	if { [string length $f] == 0 } {
		spawn curl -D - -X$m "http://localhost:2112$u"
	} else {
		spawn curl -D - -X$m "http://localhost:2112$u" --data-binary "@$f"
	}

	expect {
		-regexp $e  {
				test_pass $n
				set match 1
			}
	}

	if {$match} { return }

	test_fail $n
	incr errors

	if {$errors >= $max_errors} {
		puts "$errors errors. Exiting..."
		exit $errors
	}
}

proc test_exec {n cmd e} {
	upvar 1 ERRORS errors
	upvar 1 MAX_ERRORS max_errors

	set rc [catch {eval exec $cmd} output]
	if {$rc == 0 && [regexp $e $output]} {
		test_pass $n
		return
	}

	test_fail $n
	incr errors

	if {$errors >= $max_errors} {
		puts "$errors errors. Exiting..."
		exit $errors
	}
}

proc test_exec_fail {n cmd e} {
	upvar 1 ERRORS errors
	upvar 1 MAX_ERRORS max_errors

	set rc [catch {eval exec $cmd} output]
	if {$rc != 0 && [regexp $e $output]} {
		test_pass $n
		return
	}

	test_fail $n
	incr errors

	if {$errors >= $max_errors} {
		puts "$errors errors. Exiting..."
		exit $errors
	}
}

proc test_server_log {n e} {
	upvar 1 ERRORS errors
	upvar 1 MAX_ERRORS max_errors
	upvar 1 server_spawn_id server_spawn_id

	set spawn_id $server_spawn_id
	expect {
		-regexp $e  {
				test_pass $n
				return
			}
	}

	test_fail $n
	incr errors

	if {$errors >= $max_errors} {
		puts "$errors errors. Exiting..."
		exit $errors
	}
}

proc wait_for_server {timeout_secs} {
	for {set i 0} {$i < $timeout_secs} {incr i} {
		set rc [catch {exec curl -sSf http://localhost:2112/_/dog} output]
		if {$rc == 0} {
			return
		}

		sleep 1
	}

	test_fail "httagd startup"
	exit 1
}


# A diagnostic alone is not success: also check the child's exit status.
# Keep failures local so the caller's finally block can remove its test home.
proc test_cli {n cmd success {pattern {}}} {
	global ERRORS
	set timeout 10
	set completed 0
	# Expand an argv list so TAGL and path arguments keep their original boundaries.
	spawn -noecho {*}$cmd
	set child $spawn_id
	expect {
		-i $child
		eof { set completed 1 }
		timeout { catch {exec kill -KILL [exp_pid -i $child]} }
	}
	set output $expect_out(buffer)
	set status [wait -i $child]
	# A signal appends wait metadata; only a normal exit satisfies this contract.
	if {$completed && [llength $status] == 4 && [lindex $status 2] == 0
		&& (([lindex $status 3] == 0) == $success) && [regexp $pattern $output]} {
		test_pass $n
	} else {
		test_fail $n
		puts "exit status: $status; output: $output"
		incr ERRORS
	}
}

test_exec_fail "httagd_trace_removed" \
	 "../bin/httagd --trace" \
	 {httagd: --trace has been retired; use --log-level with _role:httagd:debug}

eval $spawn_httagd
set server_spawn_id $spawn_id

expect {
	-regexp {-- httagd start bind_addr=127\.0\.0\.1 bind_port=2112} {
		test_pass "log_level_httagd_notice_start"
	}
	timeout {
		test_fail "log_level_httagd_notice_start"
		exit 1
	}
}

wait_for_server $STARTUP_TIMEOUT

test_exec "get_dog" \
	 "curl -sSf http://localhost:2112/_/dog" \
	 "dog kind_of mammal"

test_server_log "log_level_httagd_info_request_method" \
	 {-- httagd request method=GET path=/_/dog}

test_server_log "log_level_httagd_info_request_code" \
	 {-- httagd code=TAGD_OK}

test "put_dolphin" \
	 "PUT" "/_/dolphin" ">> dolphin kind_of whale" \
	 "200 OK"

test "get_dolphin" \
	 "GET" "/_/dolphin" "" \
	 "dolphin kind_of whale"

test "get_children" \
	 "GET" "/_/mammal/" "" \
	 "dog, cat, whale, bat"

test "get_children_empty" \
	 "GET" "/_/dog/" "" \
	 "404 Not Found"

test "put_empty_tagdurl" \
	 "PUT" "" "narwhal kind_of whale" \
	 "400 Bad Request"

test "put_slash_empty_tagdurl" \
	 "PUT" "/" "narwhal kind_of whale" \
	 "400 Bad Request"

test "put_illegal_search" \
     "PUT" "/_/pigeon?q=oops" "kind_of bird" \
	 "400 Bad Request"

test "get_doggy_not_exists" \
	 "GET" "/_/doggy" "" \
	 "404 Not Found"

test_server_log "log_level_httagd_error_request_method" \
	 {-- httagd request method=GET path=/_/doggy}

test_server_log "log_level_httagd_error_request_code" \
	 {-- httagd code=TS_NOT_FOUND}

test "put_refer_doggy_no_context" \
	 "POST" "/_/doggy" "_refers_to dog" \
	 "400 Bad Request"

test "put_refer_doggy" \
	 "POST" "/_/doggy" "_refers_to dog _context simple_english" \
	 "200 OK"

test "get_doggy_no_context" \
	 "GET" "/_/doggy" "" \
	 "400 Bad Request"

test "get_doggy" \
	 "GET" "/_/doggy?c=simple_english" "" \
	 "doggy kind_of mammal(.*)_refers_to dog"

test "search" \
	 "GET" "/_/*/?q=can+bark" "" \
	 "dog"

test "tag_search" \
	 "GET" "/_/animal?q=warm+blood" "" \
	 "400 Bad Request"

# TODO httagd should produce this query (which works in tagsh):
# ?? _interrogator _sub animal _has _terms = "warm blood";
test "tag_sub_search" \
	 "GET" "/_/animal/?q=warm+blood" "" \
	 "mammal"

test "illegal_get_tag_search" \
	 "GET" "/_/*/?q=can+bark" "" \
	 "dog"


test "delete_refers_no_context" \
     "DELETE" "/_/doggy" "" \
	 "404 Not Found"

test "delete_refers_to_doggy_no_context" \
	 "DELETE" "/_/doggy" "_refers_to dog" \
	 "400 Bad Request"

test "delete_refers_to_doggy" \
	 "DELETE" "/_/doggy" "_refers_to dog _context simple_english" \
	 "200 OK"

test "get_doggy_deleted_not_exists" \
	 "GET" "/_/doggy" "" \
	 "404 Not Found"

test "delete_illegal_search" \
     "DELETE" "/_/bat?q=oops" "" \
	 "400 Bad Request"

test "delete_bat" \
     "DELETE" "/_/bat" "" \
	 "200 OK"

test "query_mammal_sub" \
	 "GET" "/_/mammal/" "" \
	 "dog, cat, whale"

test "query_parent_relator" \
     "GET" "/_/animal/blood=warm,tail,bark" "" \
	 "dog"

test "put_url" \
	 "PUT" "/_/hd:org!wikipedia!en!/wiki/Dog!!!!!!https" ">> https://en.wikipedia.org/wiki/Dog about dog _has title = \"Dog - Wikipedia, the free encyclopedia\"" \
	 "200 OK"

test "get_wiki_dog_url" \
	 "GET" "/_/hd:org!wikipedia!en!/wiki/Dog!!!!!!https" "" \
	 "https://en.wikipedia.org/wiki/Dog(.*)about dog"

# this works, but it shouldn't
# TODO encode utf8 urls
test "refer_japanese_dog" \
     "POST" "/_/イヌ" "_refers_to dog _context japanese" \
	 "200 OK"

test "get_japanese_dog_ambiguous" \
	 "GET" "/_/イヌ" "" \
	 "_error:ts_ambiguous"

# contextual get
test "get_japanese_dog" \
	 "GET" "/_/イヌ?c=japanese" "" \
	 "イヌ kind_of mammal(.*)_refers_to dog"

test "get_txt_file" \
	 "GET" "/_file/test.txt" "" \
	 "FILE_TEXT"

test_server_log "log_level_httagd_debug_file_request_path" \
	{-- httagd file request path=/_file/test.txt}

test_server_log "log_level_httagd_debug_file_system_path" \
	{-- httagd file system path=\./www/test\.txt}

test_server_log "log_level_httagd_debug_file_media_type" \
	{-- httagd file media_type=text/plain}

test_server_log "log_level_httagd_info_file_request_method" \
	{-- httagd request method=GET path=/_file/test.txt}

test_server_log "log_level_httagd_info_file_request_code" \
	{-- httagd code=TAGD_OK}

test "get_missing_txt_file" \
	 "GET" "/_file/missing.txt" "" \
	 "404 Not Found"

test_server_log "log_level_httagd_error_file_request_method" \
	 {-- httagd request method=GET path=/_file/missing.txt}

test_server_log "log_level_httagd_error_file_request_code" \
	 {-- httagd code=TS_NOT_FOUND}

# TODO
#test "refer_file" \
#     "POST" "/_/test" "_refers_to /_file/test.txt _context _file" \
#	 "200 OK"

#test "get_refered_txt_file" \
#	 "GET" "/_/test?c=_file" "" \
#	 "FILE_TEXT"

# HTTP response formatting must retain rank order despite reversed identifier order.
foreach {id parent} {
	z_order_rel _rel a_order_rel _rel
	z_order_object _entity a_order_object _entity
} {
	test "order_declare_$id" "PUT" "/_/$id" ">> $id _sub $parent;" "200 OK"
}
test "order_put_subject" "PUT" "/_/order_subject" \
	{>> order_subject _sub _entity a_order_rel z_order_object z_order_rel a_order_object, z_order_object;} \
	"200 OK"
test "order_get_subject" "GET" "/_/order_subject" "" \
	{z_order_rel z_order_object, a_order_object[\r\n]+a_order_rel z_order_object}

test "typology_source" "PUT" "/_/type_source" \
	{>> type_source _sub _entity _has _message = shared;} "200 OK"
test "typology_subject" "PUT" "/_/type_subject" \
	{>> type_subject _sub _entity _type_of type_source;} "200 OK"
test "typology_explicit" "GET" "/_/type_subject" "" \
	{type_subject _sub _entity[\r\n]+_type_of type_source[\r\n]+$}
test "typology_expanded" "POST" "/" \
	{%% _include_inherited_predicates _true; << type_subject;} \
	{type_subject _sub _entity[\r\n]+_type_of type_source[\r\n]+_has _message = shared}
test "typology_query" "POST" "/" \
	{%% _include_inherited_predicates _true; ?? _what _has _message = shared;} \
	{type_source, type_subject}
test "typology_query_explicit" "POST" "/" \
	{%% _include_inherited_predicates _false; ?? _what _has _message = shared;} \
	{type_source, type_subject}

close
wait


# HTTP application CLI contracts belong to this module, after tagsh in build order.
set config_tmp [exec mktemp -d /tmp/httagd-config-XXXXXX]
try {
	set home [file join $config_tmp home]
	file mkdir [file join $home _config]
	file copy ../../tagsh/tests/config.tagl [file join $home _config _config.tagl]
	set japanese [file join $config_tmp japanese.tagl]
	file copy ../../tagsh/tests/config-japanese.tagl $japanese
	set alternate [file join $config_tmp alternate.tagl]
	file copy ../../tagsh/tests/config-alternate.tagl $alternate
	test_cli "config_japanese_http" \
		[list ../bin/httagd --home $home --tagspace _config \
			--config $japanese --bind-port 7070 --dump] 1 {_config:bind_port = "7070"}
	test_cli "config_id_http_override" \
		[list ../bin/httagd --config-id development --bind-port 6060 \
			--home $home --tagspace _config -t {<< development;} --dump] \
		1 {_config:bind_port = "6060"}
	test_cli "config_http_cli_precedence" \
		[list ../bin/httagd --home $home --tagspace _config \
			--bind-port 7070 --config $alternate --dump] 1 {_config:bind_port = "7070"}
	test_cli "config_http_invalid_port" \
		[list ../bin/httagd --home $home --bind-port 65536 --dump] \
		0 {bind port must be}
} finally {
	file delete -force $config_tmp
}

set storage_tmp [exec mktemp -d /tmp/httagd-tagspace-XXXXXX]
try {
	set home [file join $storage_tmp home]
	test_cli "httagd_create_requires_tagspace" [list ../bin/httagd --create] 0 {--create requires --tagspace}
	test_cli "httagd_db_requires_extension" [list ../bin/httagd --db :memory:] 0 {extension}

	test_cli "httagd_dump_exits" \
		[list ../bin/httagd --home $home --tagspace _config --dump] 1 {default_config}
	test_cli "httagd_startup_error_exits" \
		[list ../bin/httagd --home $home --tagl {>> unknown _has missing;}] 0 {parse error|not_found}
	set listener [socket -server {apply {{channel host port} {close $channel}}} -myaddr 127.0.0.1 0]
	set port [lindex [fconfigure $listener -sockname] 2]
	close $listener
	spawn -noecho ../bin/httagd --home $home --tagspace _config \
		--bind-addr localhost --bind-port $port --tpl-dir ../app/tpl --www-dir ./www \
		--log-level emergency,_role:httagd:notice \
		--tagl {>> profile _sub default_config; >> alias _refers_to default_config _context profile;}
	set config_server $spawn_id
	set config_pid [exp_pid -i $config_server]
	try {
		set ready 0
		expect {
			-i $config_server -timeout $STARTUP_TIMEOUT
			-regexp {-- httagd start bind_addr=127\.0\.0\.1 bind_port=[0-9]+} {set ready 1}
			eof {}
			timeout {}
		}
		if {!$ready} {
			test_fail "config_loopback_startup"
			incr ERRORS
		} else {
			foreach {method path body} {
				PUT /_/default_config {_has _config:www_dir = "/";}
				PUT /_/profile {_has _config:tpl_dir = "/";}
				DELETE /_/default_config {}
				POST / {>> default_config _has _config:favicon = "/etc/passwd";}
				POST / {>> alias _refers_to profile _context profile;}
				PUT /_/alias?c=profile {_has _config:www_dir = "/";}
			} {
				test_cli "config_read_only_${method}_${path}" \
					[list curl -sS --max-time 10 -X $method --data $body \
						--write-out "HTTP_STATUS:%{http_code}" "http://127.0.0.1:$port$path"] \
					1 {HTTP_STATUS:403$}
			}
			test_cli "config_default_allows_selection" \
				[list curl -sS --max-time 10 -X POST \
				--data {%% _use _default; %% _tagspace _config = settings; %% _use settings; << default_config;} \
				--write-out "HTTP_STATUS:%{http_code}" "http://127.0.0.1:$port/"] \
				1 {default_config.*HTTP_STATUS:200$}
			test_cli "config_http_read_unchanged" \
				[list curl -sS --fail --max-time 10 "http://127.0.0.1:$port/_/default_config"] \
				1 {_config:www_dir = [".\/]*www}
			test_cli "config_descendant_http_read" \
				[list curl -sS --fail --max-time 10 "http://127.0.0.1:$port/_/profile"] \
				1 {profile _sub default_config}
		}
	} finally {
		catch {exec kill -TERM $config_pid}
		catch {close -i $config_server}
		wait -i $config_server
	}

	# A fresh process must serve the same data after reopening. Keep the URL
	# unprefixed: runtime tagspace selection is outside this CLI contract.
	foreach mode {create reopen} {
		# Ask the OS for a free port to avoid a fixed-port conflict with other runs.
		set listener [socket -server {apply {{channel host port} {close $channel}}} -myaddr 127.0.0.1 0]
		set port [lindex [fconfigure $listener -sockname] 2]
		close $listener
		set cmd [list ../bin/httagd --home $home --tagspace HttpZoo \
			--bind-addr 127.0.0.1 --bind-port $port --tpl-dir ../app/tpl \
			--www-dir ./www --log-level emergency,_role:httagd:notice]
		if {$mode eq "create"} {
			lappend cmd --create --tagl {>> otter _sub _entity;}
		}
		spawn -noecho {*}$cmd
		set persistent_server $spawn_id
		set persistent_pid [exp_pid -i $persistent_server]
		try {
			set ready 0
			# Synchronize with startup rather than assuming a fixed sleep is sufficient.
			expect {
				-i $persistent_server
				-timeout $STARTUP_TIMEOUT
				-regexp {-- httagd start bind_addr=127\.0\.0\.1 bind_port=[0-9]+} { set ready 1 }
				eof {}
				timeout {}
			}
			if {$ready} {
				# Require both the stored tag and HTTP 200; a body alone can mask errors.
				test_cli "httagd_tagspace_${mode}_serves_data" \
					[list curl -sS --fail --max-time 10 --write-out "\nHTTP_STATUS:%{http_code}\n" \
						"http://127.0.0.1:$port/_/otter"] 1 {otter.*HTTP_STATUS:200\r?\n$}
			} else {
				test_fail "httagd_tagspace_${mode}_startup"
				incr ERRORS
			}
		} finally {
			# Reap only the server started by this iteration, including failures.
			catch {exec kill -TERM $persistent_pid}
			catch {
				expect {
					-i $persistent_server
					-timeout 5
					eof {}
					timeout { catch {exec kill -KILL $persistent_pid} }
				}
			}
			catch {close -i $persistent_server}
			wait -i $persistent_server
		}
	}
	# A different consumer must see the same persisted state through the public API.
	test_cli "httagd_tagspace_reopens_in_tagsh" \
		[list ../../tagsh/bin/tagsh --home $home --tagspace HttpZoo --noshell --tagl {<< otter;}] 1 {otter}
} finally {
	file delete -force $storage_tmp
}

set switching_tmp [exec mktemp -d /tmp/httagd-switching-XXXXXX]
try {
	set home [file join $switching_tmp home]
	foreach name {animals plants} {
		test_cli "http_switching_create_$name" \
			[list ../../tagsh/bin/tagsh --home $home --tagspace $name --create --noshell] 1
	}
	set cold [file join $switching_tmp cold.tagl]
	set warm [file join $switching_tmp warm.tagl]
	set stream [open $cold w]
	puts $stream {%% _use animals; >> forbidden_side_effect _sub _entity;}
	close $stream
	set stream [open $warm w]
	puts $stream {>> warmtag _sub _entity;}
	close $stream
	set config [file join $switching_tmp config.tagl]
	set stream [open $config w]
	puts $stream {>> default_config _sub _config; >> animals _sub _tagspace; >> plants _sub _tagspace; >> settings _refers_to _config _context _config;}
	puts $stream ">> file://$cold; >> cold _sub _tagspace _from file://$cold;"
	close $stream
	set listener [socket -server {apply {{channel host port} {close $channel}}} -myaddr 127.0.0.1 0]
	set port [lindex [fconfigure $listener -sockname] 2]
	close $listener
	spawn -noecho ../bin/httagd --home $home --config $config --tagspace animals \
		--bind-addr 127.0.0.1 --bind-port $port --tpl-dir ../app/tpl --www-dir ./www \
		--log-level emergency,_role:httagd:notice --tagl "%% _tagspace $warm;"
	set switching_server $spawn_id
	set switching_pid [exp_pid -i $switching_server]
	try {
		set ready 0
		expect {
			-i $switching_server -timeout $STARTUP_TIMEOUT
			-regexp {-- httagd start bind_addr=127\.0\.0\.1 bind_port=[0-9]+} {set ready 1}
			eof {}
			timeout {}
		}
		if {!$ready} {
			test_fail "http_switching_startup"
			incr ERRORS
		} else {
			foreach {name body status} {
				write_other {%% _use plants; >> rose _sub _entity;} 200
				alias {%% _tagspace plants = p;} 200
				alias_repeat {%% _tagspace plants = p;} 200
				read_alias {%% _use p; << rose;} 200
				closed_tagl {%% _use cold;} 403
				open_tagl {%% _use warm; << warmtag;} 200
				config_write {%% _use _config; >> injected _sub _entity;} 403
				config_read {%% _use _config; << default_config;} 403
				config_alias {%% _use settings; << default_config;} 403
				config_binding {%% _tagspace _config = denied;} 403
				config_alias_binding {%% _tagspace settings = denied;} 403
				invalid_alias {%% _tagspace plants = _bad;} 400
				conflicting_alias {%% _tagspace animals = p;} 400
				bad_set {%% _use foo, bar; >> after_error _sub _entity;} 400
				recovered_request {>> recovered_request _sub _entity;} 200
				read_recovered_request {<< recovered_request;} 200
				close {%% !! _tagspace plants;} 403
				remove_alias {%% !! _tagspace plants = p;} 403
				unknown {%% _use undeclared;} 404
				include {%% _include "/tmp/forbidden.tagl";} 403
			} {
				test_cli "http_switching_$name" \
					[list curl -sS --max-time 10 -X POST --data $body \
					--write-out "HTTP_STATUS:%{http_code}" "http://127.0.0.1:$port/"] \
					1 "HTTP_STATUS:$status\$"
			}
			foreach id {rose forbidden_side_effect after_error} {
				test_cli "http_switching_default_isolation_$id" \
					[list curl -sS --max-time 10 --write-out "HTTP_STATUS:%{http_code}" \
					"http://127.0.0.1:$port/_/$id"] 1 {HTTP_STATUS:404$}
			}
		}
	} finally {
		catch {exec kill -TERM $switching_pid}
		catch {close -i $switching_server}
		wait -i $switching_server
	}
} finally {
	file delete -force $switching_tmp
}


# Direct-file startup never consults the implicit home configuration.
set direct_tmp [exec mktemp -d /tmp/direct-db-XXXXXX]
try {
	set db [file join $direct_tmp animals.db]
	set home [file join $direct_tmp home]
	file mkdir [file join $home .tagd _config]
	set stream [open [file join $home .tagd _config _config.tagl] w]
	puts $stream {invalid config must not be loaded;}
	close $stream
	set base [list env HOME=$home ../bin/httagd --db $db]
	test_cli "direct_missing" [concat $base [list --dump]] 0 {no such tagspace source}
	test_cli "direct_create" [concat $base [list --create --tagl {>> donkey _sub _entity;} --dump]] 1 {donkey _sub _entity}
	test_cli "direct_persist" [concat $base [list --dump]] 1 {donkey _sub _entity}
	test_cli "direct_duplicate" [concat $base [list --create --dump]] 0 {create database}
	test_cli "direct_matching_name" [concat $base [list --tagspace animals --dump]] 1 {donkey}
	test_cli "direct_wrong_name" [concat $base [list --tagspace wrong --dump]] 0 {must match}
	test_cli "direct_file_url" [list ../bin/httagd --db file://$db --dump] 1 {donkey}
	test_cli "direct_home_conflict" [concat $base [list --home $home --dump]] 0 {cannot be combined}
	test_cli "direct_missing_parent" [list ../bin/httagd --db [file join $direct_tmp absent animals.db] --create --dump] 0 {create database}
	if {[file exists [file join $direct_tmp absent]]} { incr ERRORS }
	set config [file join $direct_tmp config.tagl]
	set stream [open $config w]
	puts $stream {>> profile _sub _config _has _config:home = "/ignored/home";}
	puts $stream ">> file://$db; >> zoology _sub _tagspace _from file://$db;"
	close $stream
	test_cli "direct_source_first" [concat $base [list --config $config --tagspace zoology --dump]] 1 {disables configured home lookup.*donkey}
	test_cli "direct_source_name_mismatch" [concat $base [list --config $config --tagspace animals --dump]] 0 {must match}
	test_cli "direct_switch_reuses_source" [concat $base [list --tagl "%% _use _default; %% _use $db; << donkey;" --dump]] 1 {donkey}
} finally {
	file delete -force $direct_tmp
}

source addressing.exp

if {$ERRORS} {
	puts "$ERRORS errors."
} else {
	puts "All tests passed."
}

exit $ERRORS
