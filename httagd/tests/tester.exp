# HEAD's length must describe GET's representation for both built-in and HTML views.
foreach path {/_/type_subject /_/type_subject?v=browse.html /_/,type_source/ / /?v=browse.html} {
	set get_headers [exec curl -sS --max-time 5 -D - -o /dev/null "http://localhost:2112$path"]
	set head_headers [exec curl -sS --max-time 5 -I "http://localhost:2112$path"]
	if {[regexp {HTTP/1.1 200} $get_headers] && [regexp {HTTP/1.1 200} $head_headers]
		&& [regexp -nocase {Content-Length: ([0-9]+)} $get_headers -> get_length]
		&& [regexp -nocase {Content-Length: ([0-9]+)} $head_headers -> head_length]
		&& $get_length > 0 && $get_length == $head_length} {
		test_pass "head_matches_get_length_$path"
	} else {
		test_fail "head_matches_get_length_$path"
		puts "GET headers: $get_headers\nHEAD headers: $head_headers"
		incr ERRORS
	}
}

