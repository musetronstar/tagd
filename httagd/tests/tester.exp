#!/usr/bin/expect

# exp_internal 1   ;# diagnostics

set spawn_httagd "spawn ../bin/httagd --log-level emergency,_role:httagd:debug --file ../../tagsh/tests/bootstrap.tagl --www-dir ./www --tpl-dir ../app/tpl"

set MAX_ERRORS 3
set ERRORS 0
set NL "\r\n"
set TIMEOUT 1
set STARTUP_TIMEOUT 10

set timeout $TIMEOUT
set log_user 1  ;# log output to stdout, 0 disables

proc test_pass {n} {
	puts "\n****** $n passed ******\n"
}

proc test_fail {n} {
	puts "\n^^^^^^ $n failed ^^^^^^\n"
}

# Until expect_background drains it, nothing reads the debug server's PTY between log
# checks; a full PTY blocks the server. Each check follows the request it examines.
set server_log_background 0
proc drain_server_log {} {
	global server_spawn_id server_log_background
	if {![info exists server_spawn_id] || $server_log_background} {
		return
	}
	expect -i $server_spawn_id -timeout 0 -re {.+} {exp_continue}
}

# launches curl using args and expects
# n = <test_name>, m = method, u = url, d = <body_data>, e = <expect_args>
proc test {n m u d e} {
	upvar 1 ERRORS errors
	upvar 1 MAX_ERRORS max_errors
	upvar 1 NL nl

	set match 0
	drain_server_log

	if { [string length $d] == 0 } {
		spawn curl -D - -X$m "http://localhost:2112$u"
	} else {
		spawn curl -D - -X$m "http://localhost:2112$u" --data "$d"
	}

	expect {
		-regexp $e  {
				test_pass $n
				set match 1
			}
	}

	if {$match} { return }

	test_fail $n
	incr errors

	if {$errors >= $max_errors} {
		puts "$errors errors. Exiting..."
		exit $errors
	}
}

# launches curl using args and expects
# n = <test_name>, m = method, u = url, f = filename, e = <expect_args>
proc test_file {n m u f e} {
	upvar 1 ERRORS errors
	upvar 1 MAX_ERRORS max_errors
	upvar 1 NL nl

	set match 0
	drain_server_log

	if { [string length $f] == 0 } {
		spawn curl -D - -X$m "http://localhost:2112$u"
	} else {
		spawn curl -D - -X$m "http://localhost:2112$u" --data-binary "@$f"
	}

	expect {
		-regexp $e  {
				test_pass $n
				set match 1
			}
	}

	if {$match} { return }

	test_fail $n
	incr errors

	if {$errors >= $max_errors} {
		puts "$errors errors. Exiting..."
		exit $errors
	}
}

proc test_exec {n cmd e} {
	upvar 1 ERRORS errors
	upvar 1 MAX_ERRORS max_errors

	set rc [catch {eval exec $cmd} output]
	if {$rc == 0 && [regexp $e $output]} {
		test_pass $n
		return
	}

	test_fail $n
	incr errors

	if {$errors >= $max_errors} {
		puts "$errors errors. Exiting..."
		exit $errors
	}
}

proc test_exec_fail {n cmd e} {
	upvar 1 ERRORS errors
	upvar 1 MAX_ERRORS max_errors

	set rc [catch {eval exec $cmd} output]
	if {$rc != 0 && [regexp $e $output]} {
		test_pass $n
		return
	}

	test_fail $n
	incr errors

	if {$errors >= $max_errors} {
		puts "$errors errors. Exiting..."
		exit $errors
	}
}

proc test_server_log {n e} {
	upvar 1 ERRORS errors
	upvar 1 MAX_ERRORS max_errors
	upvar 1 server_spawn_id server_spawn_id

	set spawn_id $server_spawn_id
	expect {
		-regexp $e  {
				test_pass $n
				return
			}
	}

	test_fail $n
	incr errors

	if {$errors >= $max_errors} {
		puts "$errors errors. Exiting..."
		exit $errors
	}
}

proc wait_for_server {timeout_secs} {
	for {set i 0} {$i < $timeout_secs} {incr i} {
		set rc [catch {exec curl -sSf http://localhost:2112/_/dog} output]
		if {$rc == 0} {
			return
		}

		sleep 1
	}

	test_fail "httagd startup"
	exit 1
}


# A diagnostic alone is not success: also check the child's exit status.
# Keep failures local so the caller's finally block can remove its test home.
proc test_cli {n cmd success {pattern {}}} {
	global ERRORS
	set timeout 10
	set completed 0
	# Expand an argv list so TAGL and path arguments keep their original boundaries.
	spawn -noecho {*}$cmd
	set child $spawn_id
	expect {
		-i $child
		eof { set completed 1 }
		timeout { catch {exec kill -KILL [exp_pid -i $child]} }
	}
	set output $expect_out(buffer)
	set status [wait -i $child]
	# A signal appends wait metadata; only a normal exit satisfies this contract.
	if {$completed && [llength $status] == 4 && [lindex $status 2] == 0
		&& (([lindex $status 3] == 0) == $success) && [regexp $pattern $output]} {
		test_pass $n
	} else {
		test_fail $n
		puts "exit status: $status; output: $output"
		incr ERRORS
	}
}

# Count complete error representations, not a prefix that could hide a second body.
proc test_response {name method url status marker count {body {}} {headers {}}} {
	global ERRORS
	# Expect keeps draining the debug server's PTY while curl runs.
	spawn -noecho curl -sS --max-time 5 -D - -X $method $url --data $body {*}$headers
	set child $spawn_id
	match_max -i $child 65536
	expect -i $child -timeout 10 eof
	set output $expect_out(buffer)
	set result [wait -i $child]
	if {[llength $result] == 4 && [lindex $result 2] == 0 && [lindex $result 3] == 0
		&& [regexp "HTTP/1.1 $status" $output]
		&& [regexp -all -- $marker $output] == $count} {
		test_pass $name
	} else {
		test_fail $name
		puts $output
		incr ERRORS
	}
}

# Mutation statuses describe the committed state; a view returns GET's representation.
proc test_mutation {name method url status body {representation {}}} {
	global ERRORS
	spawn -noecho curl -sS --max-time 5 -D - -X $method $url --data $body
	set child $spawn_id
	match_max -i $child 65536
	expect -i $child -timeout 10 eof
	set output [string map {\r {}} $expect_out(buffer)]
	set result [wait -i $child]
	set boundary [string first "\n\n" $output]
	set headers [string range $output 0 $boundary]
	set content [string range $output [expr {$boundary + 2}] end]
	if {[llength $result] == 4 && [lindex $result 2] == 0 && [lindex $result 3] == 0
		&& $boundary >= 0 && [regexp "HTTP/1.1 $status" $headers]
		&& ![regexp -nocase {\nLocation:} $headers]
		&& (($representation eq {} && $content eq {})
			|| ($representation ne {} && [regexp -- $representation $content]))} {
		test_pass $name
	} else {
		test_fail $name
		puts $output
		incr ERRORS
	}
}

test_exec_fail "httagd_trace_removed" \
	 "../bin/httagd --trace" \
	 {httagd: --trace has been retired; use --log-level with _role:httagd:debug}

eval $spawn_httagd
set server_spawn_id $spawn_id

expect {
	-regexp {-- httagd start bind_addr=127\.0\.0\.1 bind_port=2112} {
		test_pass "log_level_httagd_notice_start"
	}
	timeout {
		test_fail "log_level_httagd_notice_start"
		exit 1
	}
}

wait_for_server $STARTUP_TIMEOUT

test_exec "get_dog" \
	 "curl -sSf http://localhost:2112/_/dog" \
	 "dog kind_of mammal"

test_server_log "log_level_httagd_info_request_method" \
	 {-- httagd request method=GET path=/_/dog}

test_server_log "log_level_httagd_info_request_code" \
	 {-- httagd code=TAGD_OK}

test "put_dolphin" \
	 "PUT" "/_/dolphin" ">>= dolphin kind_of whale;" \
	 "201 Created"

test "get_dolphin" \
	 "GET" "/_/dolphin" "" \
	 "dolphin kind_of whale"

test "get_children" \
	 "GET" "/_/mammal/" "" \
	 "dog, cat, whale, bat"

test "get_children_empty" \
	 "GET" "/_/dog/" "" \
	 "404 Not Found"

test "put_empty_tagdurl" \
	 "PUT" "" ">>= narwhal kind_of whale;" \
	 "400 Bad Request"

test "put_slash_empty_tagdurl" \
	 "PUT" "/" ">>= narwhal kind_of whale;" \
	 "400 Bad Request"

test "put_illegal_search" \
     "PUT" "/_/pigeon?q=oops" ">>= pigeon kind_of bird;" \
	 "400 Bad Request"

test "get_doggy_not_exists" \
	 "GET" "/_/doggy" "" \
	 "404 Not Found"

test_server_log "log_level_httagd_error_request_method" \
	 {-- httagd request method=GET path=/_/doggy}

test_server_log "log_level_httagd_error_request_code" \
	 {-- httagd code=TS_NOT_FOUND}

test "put_refer_doggy_no_context" \
	 "POST" "/_/doggy" ">> doggy _refers_to dog;" \
	 "400 Bad Request"

test "put_refer_doggy" \
	 "POST" "/_/doggy" ">> doggy _refers_to dog _context simple_english;" \
	 "200 OK"

test "get_doggy_no_context" \
	 "GET" "/_/doggy" "" \
	 "409 Conflict"

test "get_doggy" \
	 "GET" "/_/doggy?c=simple_english" "" \
	 "doggy kind_of mammal(.*)_refers_to dog"

test "search" \
	 "GET" "/_/*/?q=can+bark" "" \
	 "dog"

test "tag_search" \
	 "GET" "/_/animal?q=warm+blood" "" \
	 "400 Bad Request"

# TODO httagd should produce this query (which works in tagsh):
# ?? _interrogator _sub animal _has _terms = "warm blood";
test "tag_sub_search" \
	 "GET" "/_/animal/?q=warm+blood" "" \
	 "mammal"

test "illegal_get_tag_search" \
	 "GET" "/_/*/?q=can+bark" "" \
	 "dog"


test "delete_refers_no_context" \
     "DELETE" "/_/doggy" "" \
	 "404 Not Found"

test "delete_refers_to_doggy_no_context" \
	 "POST" "/_/doggy" "!! doggy _refers_to dog;" \
	 "400 Bad Request"

test "delete_refers_to_doggy" \
	 "POST" "/_/doggy" "!! doggy _refers_to dog _context simple_english;" \
	 "200 OK"

test "get_doggy_deleted_not_exists" \
	 "GET" "/_/doggy" "" \
	 "404 Not Found"

test "delete_illegal_search" \
     "DELETE" "/_/bat?q=oops" "" \
	 "400 Bad Request"

test "delete_bat" \
     "DELETE" "/_/bat" "" \
	 "200 OK"

test "query_mammal_sub" \
	 "GET" "/_/mammal/" "" \
	 "dog, cat, whale"

test "query_parent_relator" \
     "GET" "/_/animal/blood=warm,tail,bark" "" \
	 "dog"

test "put_url" \
	 "PUT" "/_/hd:org!wikipedia!en!/wiki/Dog!!!!!!https" ">>= https://en.wikipedia.org/wiki/Dog about dog _has title = \"Dog - Wikipedia, the free encyclopedia\"" \
	 "201 Created"

test "get_wiki_dog_url" \
	 "GET" "/_/hd:org!wikipedia!en!/wiki/Dog!!!!!!https" "" \
	 "https://en.wikipedia.org/wiki/Dog(.*)about dog"

# this works, but it shouldn't
# TODO encode utf8 urls
test "refer_japanese_dog" \
     "POST" "/_/イヌ" ">> イヌ _refers_to dog _context japanese;" \
	 "200 OK"

test "get_japanese_dog_ambiguous" \
	 "GET" "/_/イヌ" "" \
	 "_error:ts_ambiguous"

# contextual get
test "get_japanese_dog" \
	 "GET" "/_/イヌ?c=japanese" "" \
	 "イヌ kind_of mammal(.*)_refers_to dog"

test "get_txt_file" \
	 "GET" "/_file/test.txt" "" \
	 "FILE_TEXT"

test_server_log "log_level_httagd_debug_file_request_path" \
	{-- httagd file request path=/_file/test.txt}

test_server_log "log_level_httagd_debug_file_system_path" \
	{-- httagd file system path=\./www/test\.txt}

test_server_log "log_level_httagd_debug_file_media_type" \
	{-- httagd file media_type=text/plain}

test_server_log "log_level_httagd_info_file_request_method" \
	{-- httagd request method=GET path=/_file/test.txt}

test_server_log "log_level_httagd_info_file_request_code" \
	{-- httagd code=TAGD_OK}

test "get_missing_txt_file" \
	 "GET" "/_file/missing.txt" "" \
	 "404 Not Found"

test_server_log "log_level_httagd_error_file_request_method" \
	 {-- httagd request method=GET path=/_file/missing.txt}

test_server_log "log_level_httagd_error_file_request_code" \
	 {-- httagd code=TS_NOT_FOUND}

# TODO
#test "refer_file" \
#     "POST" "/_/test" "_refers_to /_file/test.txt _context _file" \
#	 "200 OK"

#test "get_refered_txt_file" \
#	 "GET" "/_/test?c=_file" "" \
#	 "FILE_TEXT"

# No later assertion reads server logs; keep its PTY drained during request matrices.
set server_log_background 1
expect_background -i $server_spawn_id -re {.+} {}

# Complete TAGL bodies: reject the entire request before any statement executes.
set origin http://localhost:2112
test_response alias_setup POST $origin/ 200 {>> err:} 0 {
	>> review_alias _refers_to dog _context simple_english;
}
foreach method {POST PATCH} {
	test_response "alias_${method}_target_conflict" $method \
		$origin/_/review_alias?c=simple_english 409 {_error:ts_ambiguous} 1 \
		{>> review_alias _refers_to cat _context simple_english;}
	test_response "alias_${method}_context_conflict" $method \
		$origin/_/review_alias?c=simple_english 409 {_error:ts_ambiguous} 1 \
		{>> review_alias _refers_to dog _context japanese;}
}
test_response alias_binding_preserved GET $origin/_/review_alias?c=simple_english \
	200 {_refers_to dog} 1
test_response alias_lookup_ambiguous GET $origin/_/review_alias 409 {_error:ts_ambiguous} 1
test_response alias_delete_before_context_change POST $origin/ 200 {>> err:} 0 \
	{!! review_alias _refers_to dog _context simple_english;}
test_response alias_create_in_new_context POST $origin/ 200 {>> err:} 0 \
	{>> review_alias _refers_to dog _context japanese;}
test_response alias_new_context GET $origin/_/review_alias?c=japanese 200 {_refers_to dog} 1
test_response alias_old_context_removed GET $origin/_/review_alias?c=simple_english \
	409 {_error:ts_ambiguous} 1

test_response body_setup POST $origin/ 200 {>> err:} 0 {
	>> body_type _sub _entity;
	>> body_dog _sub _entity _type_of body_type _has _message = old;
}
foreach command {>>+ !!+} {
	test_response "body_root_storage_$command" POST $origin/ 403 {>> err:} 1 "$command file:///tmp/http-body-probe;"
	test_response "body_PUT_storage_$command" PUT $origin/_/body_dog 403 {>> err:} 1 "$command body_dog;"
}
test_response body_put_replace PUT $origin/_/body_dog 204 {>> err:} 0 \
	{>>= body_dog _sub _entity _type_of body_type;}
test_response body_put_removed GET $origin/_/body_dog 200 {_has _message} 0
foreach body {
	{body_dog _sub _entity;}
	{>> body_dog _has _message = unwanted;}
	{!! body_dog _type_of body_type;}
	{>>= body_dog _sub _entity; >>= body_dog _sub _entity _has _message = unwanted;}
	{>>= body_other _sub _entity;}
	{%% _ignore_duplicates _true;}
} {
	test_response "body_put_reject_$body" PUT $origin/_/body_dog 400 {>> err:} 1 $body
	test_response "body_put_preserved_$body" GET $origin/_/body_dog 200 {_type_of body_type} 1
}
test_response body_whitespace_and_quoted_commands POST $origin/_/body_dog 200 {>> err:} 0 {

	>> body_dog _has _message = "commands >>; %% are text";

}
test_response body_post_merge POST $origin/_/body_dog 200 {>> err:} 0 \
	{>> body_dog _has _message = merged;}
test_response body_post_remove POST $origin/_/body_dog 200 {>> err:} 0 \
	{!! body_dog _type_of body_type;}
foreach method {POST PATCH} {
	foreach body {
		{!! body_dog;}
		{>> body_other _sub _entity;}
		{%% _ignore_duplicates _true;}
		{_has _message = unwanted}
		{>>= body_dog _sub _entity;}
		{<< body_dog;}
		{?? _what;}
		{>> body_dog _has _message = unwanted; !! body_dog _has _message;}
		{>> body_dog _has _message = unwanted; %% _context body_type;}
	} {
		test_response "body_${method}_reject_$body" $method $origin/_/body_dog 400 {>> err:} 1 $body
		test_response "body_${method}_preserved_$body" GET $origin/_/body_dog 200 {_message = merged} 1
	}
	foreach command {>>+ !!+} {
		test_response "body_${method}_storage_$command" $method $origin/_/body_dog 403 {>> err:} 1 "$command body_dog;"
	}
}
test_response body_delete_content DELETE $origin/_/body_dog 400 {_error:ts_misuse} 1 \
	{_has _message = merged}
test_response body_delete_content_preserved GET $origin/_/body_dog 200 {_message = merged} 1
test_response body_patch_merge PATCH $origin/_/body_dog 204 {>> err:} 0 \
	{>> body_dog _type_of body_type;}
test_response body_patch_remove PATCH $origin/_/body_dog 204 {>> err:} 0 \
	{!! body_dog _has _message;}
test_response body_patch_removed GET $origin/_/body_dog 200 {_has _message} 0
test_response body_patch_absent PATCH $origin/_/body_absent 404 {_error:ts_not_found} 1 \
	{>> body_absent _sub _entity;}
test_response body_patch_absent_unchanged GET $origin/_/body_absent 404 {_error:ts_not_found} 1
test_response body_post_create POST $origin/_/body_absent 200 {>> err:} 0 \
	{>> body_absent _sub _entity;}
test_response body_root_remove POST $origin/ 200 {>> err:} 0 \
	{!! body_dog _type_of body_type;}
test_response body_root_removed GET $origin/_/body_dog 200 {_type_of} 0
test_exec body_patch_media_type \
	[list curl -sS -D - -X PATCH -H {Content-Type: application/json} \
		--data {[]} $origin/_/body_dog] \
	{415 Unsupported Media Type.*Accept-Patch: text/plain, application/x-www-form-urlencoded}
foreach {name header} {
	absent {Content-Type:}
	plain {Content-Type: text/plain}
	parameters {Content-Type: Text/Plain; charset=utf-8}
	form {Content-Type: application/x-www-form-urlencoded}
} {
	test_response "body_patch_media_$name" PATCH $origin/_/body_dog 204 {>> err:} 0 \
		{>> body_dog _has _message = media;} [list -H $header]
}
test_response body_delete_whole DELETE $origin/_/body_dog 200 {>> err:} 0
test_response body_delete_absent GET $origin/_/body_dog 404 {_error:ts_not_found} 1

test_response media_setup POST $origin/ 200 {>> err:} 0 \
	{>> media_subject _sub _entity _has _message = initial;}
foreach {name method path command success} {
	put PUT /_/media_subject >>= 204
	post POST /_/media_subject >> 200
	root POST / >> 200
	patch PATCH /_/media_subject >> 204
} {
	foreach {format header} {
		absent {Content-Type:}
		plain {Content-Type: text/plain}
		parameters {Content-Type: Text/Plain; charset=utf-8}
		form {Content-Type: application/x-www-form-urlencoded}
	} {
		set value ${name}_${format}
		test_response "media_${name}_accept_$format" $method $origin$path $success {>> err:} 0 \
			"$command media_subject _sub _entity _has _message = $value;" [list -H $header]
		test_response "media_${name}_applied_$format" GET $origin/_/media_subject 200 \
			"_message = $value" 1
	}
	foreach {format type} {
		json application/json
		multipart multipart/form-data
		raw application/octet-stream
	} {
		set body "$command media_subject _sub _entity _has _message = rejected;"
		set headers [list -H "Content-Type: $type"]
		test_response "media_${name}_reject_$format" $method $origin$path 415 \
			{_has _message = .*text/plain, application/x-www-form-urlencoded} 1 $body $headers
		test_response "media_${name}_accept_patch_$format" $method $origin$path 415 \
			{Accept-Patch: text/plain, application/x-www-form-urlencoded} \
			[expr {$method eq "PATCH" ? 1 : 0}] $body $headers
		test_response "media_${name}_preserved_$format" GET $origin/_/media_subject 200 \
			"_message = ${name}_form" 1
	}
	test_response "media_${name}_reject_before_context" $method \
		$origin$path?c=media_unknown_context 415 {text/plain, application/x-www-form-urlencoded} \
		[expr {$method eq "PATCH" ? 2 : 1}] \
		"$command media_subject _sub _entity;" [list -H {Content-Type: application/json}]
	test_response "media_${name}_context_preserved" GET $origin/_/media_unknown_context \
		404 {_error:ts_not_found} 1
}
foreach {format header} {
	absent {Content-Type:}
	plain {Content-Type: text/plain; charset=utf-8}
	form {Content-Type: application/x-www-form-urlencoded}
	json {Content-Type: application/json}
	multipart {Content-Type: multipart/form-data}
	raw {Content-Type: application/octet-stream}
} {
	test_response "media_delete_content_$format" DELETE $origin/_/media_subject 400 \
		{_error:ts_misuse} 1 {!! media_subject;} [list -H $header]
	test_response "media_delete_preserved_$format" GET $origin/_/media_subject 200 \
		{_message = patch_form} 1
}

# Every PUT outcome, retry, and PATCH response is independent of TAGL duplicates.
foreach {suffix view representation} {
	plain {} {}
	tagl {?v=tagl} {status_tagl _sub _entity}
	empty {?v=} {status_empty _sub _entity}
	html {?v=tag.html} {status_html}
} {
	set id status_$suffix
	set target $origin/_/$id$view
	test_mutation "status_put_created_$suffix" PUT $target 201 \
		">>= $id _sub _entity _has _message = old;" $representation
	test_mutation "status_put_replaced_$suffix" PUT $target [expr {$view eq {} ? 204 : 200}] \
		">>= $id _sub _entity;" $representation
	test_mutation "status_put_unchanged_$suffix" PUT $target [expr {$view eq {} ? 204 : 200}] \
		">>= $id _sub _entity;" $representation
	test_response "status_get_replaced_$suffix" GET $origin/_/$id 200 {_has _message} 0
	test_mutation "status_patch_merge_$suffix" PATCH $target [expr {$view eq {} ? 204 : 200}] \
		">> $id _has _message = patched;" $representation
	test_mutation "status_patch_unchanged_$suffix" PATCH $target [expr {$view eq {} ? 204 : 200}] \
		">> $id _has _message = patched;" $representation
	test_mutation "status_patch_remove_$suffix" PATCH $target [expr {$view eq {} ? 204 : 200}] \
		"!! $id _has _message;" $representation
	test_response "status_patch_remove_repeat_$suffix" PATCH $target 404 {cannot delete non-existent relation} 1 \
		"!! $id _has _message;"
	test_response "status_post_remove_missing_$suffix" POST $target 404 {cannot delete non-existent relation} 1 \
		"!! $id _has _message;"
	test_mutation "status_post_merge_$suffix" POST $origin/_/$id 200 \
		">> $id _has _message = posted;"
	test_mutation "status_post_unchanged_$suffix" POST $origin/_/$id 200 \
		">> $id _has _message = posted;"
	test_mutation "status_post_remove_$suffix" POST $target 200 "!! $id _has _message;"
	test_response "status_post_remove_repeat_$suffix" POST $target 404 {cannot delete non-existent relation} 1 \
		"!! $id _has _message;"
	test_mutation "status_post_restore_$suffix" POST $target 200 \
		">> $id _has _message = posted;"
}
foreach setting {_false _true} {
	test_response "status_root_post_duplicates_$setting" POST $origin/ 200 {>> err:} 0 \
		"%% _ignore_duplicates $setting; >> status_plain _has _message = posted;"
}
test_response status_patch_bad_view PATCH "$origin/_/status_plain?v=missing" 404 {>> err:} 1 \
	{>> status_plain _has _message = unwanted;}
test_response status_patch_bad_view_preserved GET $origin/_/status_plain 200 {_message = posted} 1

# HTTP response formatting must retain rank order despite reversed identifier order.
foreach {id parent} {
	z_order_rel _rel a_order_rel _rel
	z_order_object _entity a_order_object _entity
} {
	test "order_declare_$id" "PUT" "/_/$id" ">>= $id _sub $parent;" "201 Created"
}
test "order_put_subject" "PUT" "/_/order_subject" \
	{>>= order_subject _sub _entity a_order_rel z_order_object z_order_rel a_order_object, z_order_object;} \
	"201 Created"
test "order_get_subject" "GET" "/_/order_subject" "" \
	{z_order_rel z_order_object, a_order_object[\r\n]+a_order_rel z_order_object}

test "typology_source" "PUT" "/_/type_source" \
	{>>= type_source _sub _entity _has _message = shared;} "201 Created"
test "typology_subject" "PUT" "/_/type_subject" \
	{>>= type_subject _sub _entity _type_of type_source;} "201 Created"
test "typology_explicit" "GET" "/_/type_subject" "" \
	{type_subject _sub _entity[\r\n]+_type_of type_source[\r\n]+$}
test "typology_expanded" "POST" "/" \
	{%% _include_inherited_predicates _true; << type_subject;} \
	{type_subject _sub _entity[\r\n]+_type_of type_source[\r\n]+_has _message = shared}
test "typology_query" "POST" "/" \
	{%% _include_inherited_predicates _true; ?? _what _has _message = shared;} \
	{type_source, type_subject}
test "typology_query_explicit" "POST" "/" \
	{%% _include_inherited_predicates _false; ?? _what _has _message = shared;} \
	{type_source, type_subject}

# Query paths map to existing TAGL type predicates, including reflexive inheritance.
test "types_post_body" "POST" "/_/type_post" {>> type_post _sub _entity _type_of type_source;} "200 OK"
test "types_query" "GET" "/_/,type_source/" "" {type_source, type_subject, type_post}
test_exec "types_query_head_has_no_body" \
	[list curl -sS --ignore-content-length --max-time 5 -X HEAD -H {Connection: close} \
		-o /dev/null --write-out {HTTP_STATUS:%{http_code} BODY_BYTES:%{size_download}} \
		http://localhost:2112/_/,type_source/] {HTTP_STATUS:200 BODY_BYTES:0$}
test_exec "types_invalid_head_has_no_body" \
	[list curl -sS --ignore-content-length --max-time 5 -X HEAD -H {Connection: close} \
		-o /dev/null --write-out {HTTP_STATUS:%{http_code} BODY_BYTES:%{size_download}} \
		http://localhost:2112/_/type_subject,type_source] {HTTP_STATUS:400 BODY_BYTES:0$}
test "types_query_sub_and_type" "GET" "/_/_entity,type_source/" "" {type_source, type_subject, type_post}
foreach method {GET HEAD POST PUT DELETE} {
	test "types_nonquery_$method" $method "/_/type_subject,type_source" "" {400 Bad Request}
	test "types_bad_syntax_$method" $method "/_/type_subject,,type_source/" "" {400 Bad Request}
}
foreach method {POST PUT DELETE} {
	foreach path {/_/type_source/ /_/,type_source/ /_/type_subject,type_source/} {
		test "types_write_query_${method}_$path" $method $path {_has _message = unwanted} {_error:ts_misuse}
	}
}
test "types_write_rejection_preserves_subject" "GET" "/_/type_subject" "" \
	{type_subject _sub _entity[\r\n]+_type_of type_source[\r\n]+$}
test "types_context_create" "POST" "/" \
	{>> type_context _sub _entity; >> movable _refers_to type_source _context type_context;} "200 OK"
test "types_context_query" "GET" "/_/,movable/?c=type_context" "" {movable, type_subject, type_post}
test "types_context_post" "POST" "/_/type_context?c=type_context" {>> type_context _has _message = contextual;} "200 OK"
test "types_context_delete" "POST" "/_/type_context?c=type_context" {!! type_context _has _message = contextual;} "200 OK"
test "types_context_root_post" "POST" "/?c=type_context" {<< movable;} {movable _sub _entity}
foreach method {GET POST PUT DELETE} {
	test "types_missing_context_$method" $method "/_/type_subject?c=absent" "" {_error:ts_not_found}
}

# A rejected address must not execute even a self-contained statement in the body.
foreach method {PUT POST DELETE} {
	foreach {path error} {
		/_/rejected_body,type_source ts_misuse
		/_/type_source/ ts_misuse
		/_/rejected_body?c=absent ts_not_found
		/_/rejected_body?c=type_context,,type_context tagl_err
	} {
		test "rejected_statement_${method}_$path" $method $path \
			{>> rejected_body _sub _entity;} "_error:$error"
		test "rejected_statement_absent_${method}_$path" "GET" "/_/rejected_body" "" \
			{404 Not Found}
	}
}
foreach {query error} {c=absent ts_not_found c=type_context, tagl_err} {
	test "rejected_root_statement_$query" "POST" "/?$query" \
		{>> rejected_body _sub _entity;} "_error:$error"
	test "rejected_root_statement_absent_$query" "GET" "/_/rejected_body" "" \
		{404 Not Found}
}

# TAGL owns request-target syntax, including options and raw URL substitution.
set malformed_body [file tempfile malformed_body_path]
puts -nonewline $malformed_body "<< /_/[string repeat hd:/ 131072]x;"
close $malformed_body
test_exec malformed_uri_large_post [list curl -sS --max-time 5 -X POST \
	http://localhost:2112/ --data-binary "@$malformed_body_path" -w {HTTP_STATUS:%{http_code}}] \
	{HTTP_STATUS:400}
file delete $malformed_body_path

# Writes a TAGL body of exactly size bytes: the statement, then one comment line.
proc sized_tagl_body {statement size} {
	set body [file tempfile path]
	set prefix "$statement\n-- "
	puts -nonewline $body "$prefix[string repeat x [expr {$size - [string length $prefix] - 1}]]\n"
	close $body
	return $path
}

# libevhtp buffers a whole body before TAGL reads it; larger bodies close the connection unexecuted.
set limit_body [sized_tagl_body {>> limit_body_probe _sub _entity;} 16777216]
test_exec limit_body_accepted [list curl -sS --max-time 10 -X POST http://localhost:2112/ \
	--data-binary "@$limit_body" -w {HTTP_STATUS:%{http_code}}] {HTTP_STATUS:200}
file delete $limit_body
test_response limit_body_executed GET {http://localhost:2112/_/limit_body_probe} \
	200 {limit_body_probe} 1

set oversized_body [sized_tagl_body {>> oversized_body_probe _sub _entity;} 16777217]
foreach {name headers} {length {} chunked {-H {Transfer-Encoding: chunked}}} {
	test_exec_fail "oversized_body_$name" [list curl -sS --max-time 10 -X POST {*}$headers \
		http://localhost:2112/ --data-binary "@$oversized_body"] {\((52|55|56)\)}
}
file delete $oversized_body
test_response oversized_body_not_executed GET {http://localhost:2112/_/oversized_body_probe} \
	404 {_error:ts_not_found} 1
test_response oversized_body_server_alive GET {http://localhost:2112/_/dog} 200 {dog} 1
