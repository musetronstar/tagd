#!/usr/bin/expect

# exp_internal 1   ;# diagnostics

set spawn_tagsh "spawn ../bin/tagsh"
set bootstrap bootstrap.tagl

set PROMPT "tagd> "
set MAX_ERRORS 3
set ERRORS 0
set NL "\r\n"   ;# WTF
set TIMEOUT 1

set timeout $TIMEOUT
set log_user 1  ;# log output to stdout, 0 disables

proc test_pass {n} {
	puts "\n****** $n passed ******\n"
}

proc test_fail {n} {
	puts "\n^^^^^^ $n failed ^^^^^^\n"
}

# sends a tagls string and expects args
# n = <test_name>, s = <tagl_string>, e = <expect_args>
proc test {n s e} {
	upvar 1 ERRORS errors
	upvar 1 MAX_ERRORS max_errors
	upvar 1 NL nl
	upvar 1 PROMPT prompt

	set match 0

	send "$s$nl"
	expect "$s$nl"	;# eat the echoed statement

	expect {
		-regexp $e  {
				test_pass $n
				set match 1
			}
	}

	# eats output up to the next prompt
	expect $prompt

	if {$match} { return }

	test_fail $n
	incr errors

	if {$errors >= $max_errors} {
		puts "$errors errors. Exiting..."
		exit $errors
	}
}

# like test, but fails if the expect args are true
# use sparingly because it has to timeout for success
proc test_neg {n s e} {
	upvar 1 ERRORS errors
	upvar 1 MAX_ERRORS max_errors
	upvar 1 NL nl
	upvar 1 PROMPT prompt

	set match 0

	send "$s$nl"
	expect "$s$nl"	;# eat the echoed statement

	expect {
		-regexp $e  {
				test_fail $n
				incr errors

				if {$errors >= $max_errors} {
					puts "$errors errors. Exiting..."
					exit $errors
				}

				set match 1
			}
		default		;# timeout,eof ok
	}

	# eats output up to the next prompt
	expect $prompt

	if {$match} { return }  ;# failed

	test_pass $n
}


# A diagnostic alone is not success: also check the child's exit status.
# Keep failures local so the caller's finally block can remove its test home.
proc test_cli {n cmd success {pattern {}}} {
	global ERRORS
	set timeout 10
	set completed 0
	# Expand an argv list so names with spaces remain one argument.
	spawn -noecho {*}$cmd
	set child $spawn_id
	expect {
		-i $child
		eof { set completed 1 }
		timeout { catch {exec kill -KILL [exp_pid -i $child]} }
	}
	set output $expect_out(buffer)
	set status [wait -i $child]
	# A signal appends wait metadata; only a normal exit satisfies this contract.
	if {$completed && [llength $status] == 4 && [lindex $status 2] == 0
		&& (([lindex $status 3] == 0) == $success) && [regexp $pattern $output]} {
		test_pass $n
	} else {
		test_fail $n
		puts "exit status: $status; output: $output"
		incr ERRORS
	}
}

proc test_storage_check {n passed} {
	global ERRORS
	if {$passed} {
		test_pass $n
	} else {
		test_fail $n
		incr ERRORS
	}
}

eval $spawn_tagsh
expect "use .show to list commands$NL"
expect $PROMPT

# passes when output does not contain TAGL_ERR or "no such file"
test_neg "bootstrap" \
	     ".load $bootstrap" \
	     "(TAGL_ERR)|(no such file)"

test_neg "bootstrap_quiet" \
	     ".load $bootstrap" \
	     "-- TAGD_OK"

test "bootstrap_reload_duplicate" \
	 ".load $bootstrap" \
	 "_error:ts_duplicate"

test "tagspaces_active_default" \
	".tagspaces" \
	{\* _default[\t ]+reserved/open}

test "malformed_tagspace_argument" \
	"%% _use foo, bar;" \
	{_error:tagl_err}
test "valid_statement_after_malformed_set" \
	">> review_recovered _sub _entity;" \
	{TAGD_OK}
test "unterminated_tagspace_argument" \
	{%% _tagspace "unterminated} \
	{_error:tagl_err}
test "read_after_unterminated_set" \
	"<< review_recovered;" \
	{review_recovered _sub _entity}


# Exercise boolean vocabulary through the real shell and SQLite callbacks.
test "boolean_define_yes" \
	">> yes <: _true;" \
	"TAGD_OK"

test "boolean_define_no" \
	">> no <: _false;" \
	"TAGD_OK"

test "boolean_define_certainly" \
	">> certainly <: yes;" \
	"TAGD_OK"

# A duplicate PUT makes the effect of each SET visible.
test "boolean_literal_true_ignores_duplicate" \
	"%% _ignore_duplicates _true; >> certainly <: yes;" \
	"TAGD_OK"

test "boolean_literal_false_reports_duplicate" \
	"%% _ignore_duplicates _false; >> certainly <: yes;" \
	"_error:ts_duplicate"

test "boolean_yes_ignores_duplicate" \
	"%% _ignore_duplicates yes; >> certainly <: yes;" \
	"TAGD_OK"

test "boolean_no_reports_duplicate" \
	"%% _ignore_duplicates no; >> certainly <: yes;" \
	"_error:ts_duplicate"

test "boolean_certainly_ignores_duplicate" \
	"%% _ignore_duplicates certainly; >> certainly <: yes;" \
	"TAGD_OK"

test "boolean_rejects_zero" \
	"%% _ignore_duplicates 0;" \
	"_error:tagl_err"

test "boolean_rejected_zero_preserves_true" \
	">> certainly <: yes;" \
	"TAGD_OK"

test "boolean_disable_before_rejected_numbers" \
	"%% _ignore_duplicates no; >> certainly <: yes;" \
	"_error:ts_duplicate"

test "boolean_rejects_one" \
	"%% _ignore_duplicates 1;" \
	"_error:tagl_err"

test "boolean_rejects_larger_number" \
	"%% _ignore_duplicates 5;" \
	"_error:tagl_err"

test "boolean_rejected_numbers_preserve_false" \
	">> certainly <: yes;" \
	"_error:ts_duplicate"

send "%% _context simple_english$NL"
expect "%% _context simple_english$NL"
expect $PROMPT

test "put_url_dog" \
     ">> https://en.wikipedia.org/wiki/Dog about dog has title = \"Dog - Wikipedia, the free encyclopedia\"" \
	 "TAGD_OK"

test "get_url_dog" \
     "<< https://en.wikipedia.org/wiki/Dog ;" \
	 "https://en.wikipedia.org/wiki/Dog(.*)about dog"

test "put_url_dog2" \
    ">> http://animal.discovery.com/breed-selector/dog-breeds.html about dog" \
	"TAGD_OK"

test "put_url_cat" \
    ">> https://en.wikipedia.org/wiki/Cat about cat" \
	"TAGD_OK"

test "tag_sub_search" \
	 "?? _interrogator _sub animal _has _terms = \"warm blood\";" \
	 "mammal"

test "tag_sub_symbol_search" \
	 "?? _interrogator <: animal -> _terms = \"warm blood\";" \
	 "mammal"

test "search" \
	 "?? \"dog\";" \
	"https://en.wikipedia.org/wiki/Dog, http://animal.discovery.com/breed-selector/dog-breeds.html, dog"

test "query_url_dog" \
     "?? what is_a _url about dog" \
	"https://en.wikipedia.org/wiki/Dog, http://animal.discovery.com/breed-selector/dog-breeds.html"

test "query_url_animal" \
     "?? what is_a _url * animal" \
	"https://en.wikipedia.org/wiki/Dog, http://animal.discovery.com/breed-selector/dog-breeds.html, https://en.wikipedia.org/wiki/Cat"

test "query_url_animal_wikipedia" \
	"?? what is_a _url * animal
	_has _private = wikipedia, _public = org" \
	"https://en.wikipedia.org/wiki/Dog, https://en.wikipedia.org/wiki/Cat"

send ".exit$NL"
expect eof
wait

test_cli "put_changed_modifier" \
	[list ../bin/tagsh --noshell \
		--tagl {>> settings _sub _entity _has _message = "before";} \
		--tagl {>> settings _has _message = "after";} \
		--tagl {<< settings;}] 1 {_message = after}

test_cli "put_unchanged_modifier_is_duplicate" \
	[list ../bin/tagsh --noshell \
		--tagl {>> settings _sub _entity _has _message = "before";} \
		--tagl {>> settings _has _message = "after";} \
		--tagl {>> settings _has _message = "after";}] 0 {TS_DUPLICATE|ts_duplicate}


test_cli "bare_put_preserves_modifier" \
	[list ../bin/tagsh -n -t {>> animal _sub _entity; >> dog _sub animal _has _message = 4; %% _ignore_duplicates _true; >> dog _has _message; << dog;}] \
	1 {_message = 4}
test_cli "delete_modifier_retains_predicate" \
	[list ../bin/tagsh -n -t {>> dog _sub _entity _has _message = 4; !! dog _has _message = 4; << dog;}] \
	1 {dog _sub _entity\r?\n_has _message\r?\n}
test_cli "delete_bare_removes_modified_predicate" \
	[list ../bin/tagsh -n -t {>> dog _sub _entity _has _message = 4; !! dog _has _message; << dog;}] \
	1 {dog _sub _entity\r?\n}
set no_home [list env -u HOME LD_PRELOAD=[file normalize no-home.so]]
test_cli "memory_without_home" \
	[concat $no_home [list ../bin/tagsh -n -t {>> homeless _sub _entity; << homeless;}]] \
	1 {homeless _sub _entity}
test_cli "explicit_config_without_home" \
	[concat $no_home [list ../bin/tagsh --config config.tagl --tagspace _config --dump]] \
	1 {_config:bind_port = 8080}
test_cli "named_storage_requires_home" \
	[concat $no_home [list ../bin/tagsh --tagspace absent --create -n]] \
	0 {invalid tagd home}

set no_home_tmp [exec mktemp -d /tmp/tagsh-no-home-XXXXXX]
set previous_dir [pwd]
set tagsh_binary [file normalize ../bin/tagsh]
try {
	file mkdir [file join $no_home_tmp _config]
	set stream [open [file join $no_home_tmp _config _config.tagl] w]
	puts $stream {invalid TAGL must not be loaded from the working directory;}
	close $stream
	cd $no_home_tmp
	test_cli "no_home_skips_cwd_config" \
		[concat $no_home [list $tagsh_binary -n -t {>> standalone _sub _entity; << standalone;}]] \
		1 {standalone _sub _entity}
} finally {
	cd $previous_dir
	file delete -force $no_home_tmp
}

set roundtrip_tmp [exec mktemp -d /tmp/tagsh-roundtrip-XXXXXX]
try {
	# Exercise simple-English referents and custom relators plus a hard-tag predicate object.
	# Tcl exec interprets arguments beginning with >> as redirection, even in lists.
	set assertions [file join $roundtrip_tmp assertions.tagl]
	set stream [open $assertions w]
	puts $stream {>> dog _has _message = "hard object";}
	close $stream
	set before [exec ../bin/tagsh -f bootstrap.tagl -f $assertions --dump]
	test_storage_check "dump_contains_hard_tag_predicate" \
		[regexp {_message = "hard object"} $before]
	set dump_file [file join $roundtrip_tmp dump.tagl]
	set stream [open $dump_file w]
	puts $stream $before
	close $stream
	set after [exec ../bin/tagsh -f $dump_file --dump]
	test_storage_check "bootstrap_dump_roundtrip" [expr {$before eq $after}]
} finally {
	file delete -force $roundtrip_tmp
}

# Configuration files are inputs only; each process gets a fresh memory tagspace.
set config_tmp [exec mktemp -d /tmp/tagsh-config-XXXXXX]
try {
	set home [file join $config_tmp home]
	file mkdir [file join $home _config]
	set default_config [file join $home _config _config.tagl]
	file copy config.tagl $default_config
	set stream [open config.tagl r]
	set original_config [read $stream]
	close $stream
	set base [list ../bin/tagsh --home $home --tagspace _config]
	set japanese [file join $config_tmp japanese.tagl]
	file copy config-japanese.tagl $japanese
	set localized [concat $base [list --config $japanese]]
	test_cli "config_japanese_file" [concat $localized [list --dump]] \
		1 {_config:bind_port = 8181}
	test_cli "config_japanese_read" \
		[concat $localized [list -n -t {%% _context 日本語; << 設定;}]] \
		1 {ポート = 8181}
	test_cli "config_japanese_runtime_validation" \
		[concat $localized [list -n -t {%% _context 日本語; >> 設定 持つ ポート = 9090;}]] \
		0 {cannot change at runtime}
	test_cli "config_japanese_inherited_profile" \
		[concat $localized [list --config-id 開発 -n \
			-t {%% _include_inherited_predicates _true; << 開発;}]] \
		1 {_config:bind_port = 8181}
	test_cli "config_id_development" \
		[concat $base [list --config-id development --noshell -t {<< development;}]] \
		1 {_config:bind_port = 9090}
	test_cli "config_id_production" \
		[concat $base [list --config-id production --noshell -t {<< production;}]] \
		1 {_config:bind_port = 7070}
	foreach id {unknown _config _config:bind_port} {
		test_cli "config_id_invalid_$id" \
			[concat $base [list --config-id $id --dump]] 0 {config (profile not found|subject)}
	}
	test_cli "config_id_empty" [concat $base [list --config-id "" --dump]] \
		0 {empty --config-id}
	test_cli "config_default_file" [concat $base [list --dump]] 1 {_config:bind_port = 8080}
	test_cli "config_cli_overrides_file" \
		[concat $base [list --log-level error --dump]] 1 {_config:log_level = error}
	set alternate [file join $config_tmp alternate.tagl]
	file copy config-alternate.tagl $alternate
	test_cli "config_alternate_replaces_default" \
		[concat $base [list --config $alternate --dump]] 1 {_config:log_level = error}
	test_cli "config_runtime_prompt" \
		[concat $base [list -t {>> default_config _has _config:prompt = "live> ";} --dump]] \
		1 {_config:prompt = "live> "}
	test_cli "config_runtime_changes_are_volatile" \
		[concat $base [list --dump]] 1 {_config:prompt = "tagd> "}
	test_cli "config_runtime_port_rejected" \
		[concat $base [list -n -t {>> default_config _has _config:bind_port = 9090;}]] \
		0 {cannot change at runtime}
	test_cli "config_cannot_delete_required_values" \
		[concat $base [list -n -t {!! default_config;}]] 0 {cannot be deleted}
	test_cli "config_explicit_missing_file" \
		[concat $base [list --config [file join $config_tmp missing.tagl] --dump]] \
		0 {cannot load config file}
	test_cli "config_reserved_creation" [concat $base [list --create --dump]] \
		0 {reserved tagspace name}
	set stream [open $default_config r]
	set contents [read $stream]
	close $stream
	test_storage_check "config_source_unchanged" \
		[expr {$contents eq $original_config}]
	set dump [exec {*}$base --dump]
	set stream [open $alternate w]
	puts $stream {%% _config_id default_config;}
	puts $stream $dump
	close $stream
	test_cli "config_dump_reloads_as_tagl" \
		[concat $base [list --config $alternate --dump]] 1 {_config:bind_port = 8080}
	set stream [open $default_config w]
	puts $stream {>> default_config _has _config:bind_port = invalid;}
	close $stream
	test_cli "config_invalid_default_fails_startup" \
		[concat $base [list --dump]] 0 {cannot load config file}
} finally {
	file delete -force $config_tmp
}

# Each run owns its temporary home; never write named test tagspaces under ~/.tagd.
set storage_tmp [exec mktemp -d /tmp/tagsh-tagspace-XXXXXX]
try {
	set home [file join $storage_tmp home]
	test_cli "tagspace_missing" \
		[list ../bin/tagsh --home $home --tagspace Zoo --noshell] 0 {no such tagspace}
	test_storage_check "tagspace_open_does_not_create_home" [expr {![file exists $home]}]
	test_cli "tagspace_create_requires_name" [list ../bin/tagsh --create] 0 {--create requires --tagspace}
	test_cli "tagspace_db_requires_extension" [list ../bin/tagsh --db :memory:] 0 {extension}

	# Exercise UTF-8 and an interior space in a storage name, not referent lookup.
	set name "動物 Zoo"
	set database [file join $home tagspaces $name "$name.db"]
	test_cli "tagspace_create_utf8_and_spaces" \
		[list ../bin/tagsh --tagspace $name --create --home $home --noshell \
			--tagl {>> donkey _sub _entity;}] 1
	test_storage_check "tagspace_database_layout" [file isfile $database]
	test_cli "tagspace_reopen" \
		[list ../bin/tagsh --home $home --tagspace $name --noshell --tagl {<< donkey;}] 1 {donkey}
	test_cli "tagspace_create_existing_rejected" \
		[list ../bin/tagsh --create --home $home --tagspace $name --noshell] 0 {tagspace exists}
	test_cli "tagspace_create_option_order" \
		[list ../bin/tagsh --create --tagspace Second --home $home --noshell] 1
	test_cli "tagspace_memory_default_is_isolated" \
		[list ../bin/tagsh --home $home --noshell --tagl {<< donkey;}] 0
	test_cli "tagspace_path_traversal_rejected" \
		[list ../bin/tagsh --home $home --create --tagspace ../escape --noshell] 0 {invalid tagspace name}

	# Re-creation is permitted when the database is gone but its directory remains.
	file delete $database
	test_cli "tagspace_recreate_in_existing_directory" \
		[list ../bin/tagsh --create --tagspace $name --home $home --noshell] 1
	test_storage_check "tagspace_recreated_database" [file isfile $database]
} finally {
	file delete -force $storage_tmp
}

test_cli "malformed_set_batch_diagnostic" \
	[list ../bin/tagsh --noshell --tagl {%% _use foo, bar;} \
	--tagl {>> after_error _sub _entity;}] 0 {_error:tagl_err}

set switching_tmp [file normalize [file join /tmp tagsh-switching-[pid]]]
file mkdir $switching_tmp
try {
	set home [file join $switching_tmp home]
	test_cli "switching_create_animals" \
		[list ../bin/tagsh --home $home --tagspace animals --create --noshell \
		--tagl {>> dog _sub _entity;}] 1
	test_cli "switching_create_plants" \
		[list ../bin/tagsh --home $home --tagspace plants --create --noshell \
		--tagl {>> tree _sub _entity;}] 1
	set configured [list ../bin/tagsh --home $home --config switching-config.tagl \
		--config-id selected_profile --noshell]
	test_cli "switching_profile_inherits_target" [concat $configured [list --dump]] 1 {dog _sub _entity}
	test_cli "switching_cli_overrides_profile" \
		[concat $configured [list --tagspace plants --dump]] 1 {tree _sub _entity}
	test_cli "switching_overridden_alias_remains_available" \
		[concat $configured [list --tagspace plants --tagl {%% _use a; << dog;}]] 1 {dog _sub _entity}
	test_cli "switching_reserved_default" \
		[list ../bin/tagsh --home $home --tagspace _default --noshell \
		--tagl {>> anonymous _sub _entity; %% _use animals; %% _use _default; << anonymous;}] \
		1 {anonymous _sub _entity}
} finally {
	file delete -force $switching_tmp
}


# Direct-file startup never consults the implicit home configuration.
set direct_tmp [exec mktemp -d /tmp/direct-db-XXXXXX]
try {
	set db [file join $direct_tmp animals.db]
	set home [file join $direct_tmp home]
	file mkdir [file join $home .tagd _config]
	set stream [open [file join $home .tagd _config _config.tagl] w]
	puts $stream {invalid config must not be loaded;}
	close $stream
	set base [list env HOME=$home ../bin/tagsh --db $db]
	test_cli "direct_missing" [concat $base [list --dump]] 0 {no such tagspace source}
	test_cli "direct_create" [concat $base [list --create --tagl {>> donkey _sub _entity;} --dump]] 1 {donkey _sub _entity}
	test_cli "direct_persist" [concat $base [list --dump]] 1 {donkey _sub _entity}
	test_cli "direct_duplicate" [concat $base [list --create --dump]] 0 {create database}
	test_cli "direct_matching_name" [concat $base [list --tagspace animals --dump]] 1 {donkey}
	test_cli "direct_wrong_name" [concat $base [list --tagspace wrong --dump]] 0 {must match}
	test_cli "direct_no_home_sources" [concat $no_home [list ../bin/tagsh --db $db --dump]] 1 {donkey}
	test_cli "direct_literal_tilde" [list env HOME=$direct_tmp ../bin/tagsh --db {~/animals.db} --dump] 1 {donkey}
	test_cli "direct_tilde_without_home" [concat $no_home [list ../bin/tagsh --db {~/animals.db} --dump]] 0 {cannot expand user home}
	test_cli "direct_file_url" [list ../bin/tagsh --db file://$db --dump] 1 {donkey}
	test_cli "direct_home_conflict" [concat $base [list --home $home --dump]] 0 {cannot be combined}
	test_cli "direct_missing_parent" [list ../bin/tagsh --db [file join $direct_tmp absent animals.db] --create --dump] 0 {create database}
	if {[file exists [file join $direct_tmp absent]]} { incr ERRORS }
	set config [file join $direct_tmp config.tagl]
	set stream [open $config w]
	puts $stream {>> profile _sub _config _has _config:home = "/ignored/home";}
	puts $stream ">> file://$db; >> zoology _sub _tagspace _from file://$db;"
	close $stream
	test_cli "direct_source_first" [concat $base [list --config $config --tagspace zoology --dump]] 1 {disables configured home lookup.*donkey}
	test_cli "direct_source_name_mismatch" [concat $base [list --config $config --tagspace animals --dump]] 0 {must match}
	test_cli "direct_switch_reuses_source" [concat $base [list --tagl "%% _use _default; %% _use $db; << donkey;" --dump]] 1 {donkey}
} finally {
	file delete -force $direct_tmp
}

# The CLI must serialize ordinary retrieved predicates and dumps in rank order.
set order_program {
	>> z_order_rel _sub _rel;
	>> a_order_rel _sub _rel;
	>> z_order_object _sub _entity;
	>> a_order_object _sub _entity;
	>> order_subject _sub _entity
		a_order_rel z_order_object z_order_rel a_order_object, z_order_object;
	<< order_subject;
}
test_cli "predicate_rank_order" \
	[concat $no_home [list ../bin/tagsh --tagl $order_program --dump]] 1 \
	{z_order_rel z_order_object, a_order_object[\r\n]+a_order_rel z_order_object}

foreach {name binding} {
	target {cat _context english}
	context {dog _context japanese}
} {
	test_cli "alias_conflict_$name" [list ../bin/tagsh --tagl "
		>> dog _sub _entity; >> cat _sub _entity;
		>> english _sub _entity; >> japanese _sub _entity;
		>> doggy _refers_to dog _context english;
		%% _ignore_duplicates _true;
		>> doggy _refers_to $binding;
	" --noshell] 0 {_error:ts_ambiguous}
}

test_cli "alias_delete_then_change_context" [list ../bin/tagsh --tagl {
	>> dog _sub _entity;
	>> english _sub _entity; >> japanese _sub _entity;
	>> doggy _refers_to dog _context english;
	!! doggy _refers_to dog _context english;
	>> doggy _refers_to dog _context japanese;
	%% _context japanese;
	<< doggy;
} --noshell] 1 {doggy.*_refers_to dog}

test_cli "replace_get" [list ../bin/tagsh --tagl {
	>> animal _sub _entity;
	>> dog _sub animal _has _message = old;
	>>= dog _sub animal _has _message = new;
	<< dog;
} --noshell] 1 {dog _sub animal.*_has _message = new}
test_cli "replace_duplicate" [list ../bin/tagsh --tagl {
	>>= dog _sub _entity;
	>>= dog _sub _entity;
} --noshell] 0 {_error:ts_duplicate}

foreach {command_name command} {put >> replace >>=} {
	foreach ignore {_false _true} {
		foreach {description predicates} {
			identity {}
			axioms {_type_of dog, _entity}
			relation {_type_of dog, _entity _has _message = note}
		} {
			set success [expr {$ignore eq "_true" || $description eq "axioms"}]
			set pattern [expr {$success ? {dog _sub _entity} : {TS_DUPLICATE|_error:ts_duplicate}}]
			test_cli "${command_name}_duplicate_${description}_${ignore}" \
				[list ../bin/tagsh --tagl "
					>> dog _sub _entity $predicates;
					%% _ignore_duplicates $ignore;
					$command dog _sub _entity $predicates;
					<< dog;
				" --noshell] $success $pattern
		}
	}
}

if {$ERRORS} {
	puts "$ERRORS errors."
} else {
	puts "All tests passed."
}

exit $ERRORS
