// declarations
%struct-type
%7bit
%language=C++
%define class-name tld_hash
%define slot-name key
%define lookup-function-name lookup

%{
const bool HASH_CONTAINS_PRIVATE_TLDS = true;
%}

// tld_code defined by including file 
struct hash_value {
    const char *key;
    tld_code code;
};
